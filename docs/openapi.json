{
  "openapi": "3.0.3",
  "info": {
    "title": "PomKita API",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": { "responses": { "200": { "description": "Service is alive" } } }
    },
    "/ready": {
      "get": { "responses": { "200": { "description": "Service is ready" }, "503": { "$ref": "#/components/responses/ServiceUnavailable" } } }
    },
    "/api/v1/login": {
      "post": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": { "200": { "description": "Session created" }, "400": { "$ref": "#/components/responses/ValidationError" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/api/v1/logout": {
      "delete": { "responses": { "204": { "description": "Session revoked" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } } }
    },
    "/api/v1/session": {
      "get": { "responses": { "200": { "description": "Current session" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/api/v1/shifts": {
      "get": { "responses": { "200": { "description": "Shift list" }, "401": { "$ref": "#/components/responses/Unauthorized" } } },
      "post": { "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OpenShiftRequest" } } } }, "responses": { "200": { "description": "Shift opened" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/api/v1/drafts/claim": {
      "post": { "parameters": [{ "$ref": "#/components/parameters/CSRF" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClaimDraftRequest" } } } }, "responses": { "200": { "description": "Draft lease" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/api/v1/drafts/heartbeat": {
      "post": { "parameters": [{ "$ref": "#/components/parameters/CSRF" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DraftLeaseRequest" } } } }, "responses": { "204": { "description": "Draft lease renewed" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/api/v1/drafts/readings": {
      "post": { "parameters": [{ "$ref": "#/components/parameters/CSRF" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DraftReadingRequest" } } } }, "responses": { "200": { "description": "Draft revision" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/api/v1/drafts/sales": {
      "post": { "parameters": [{ "$ref": "#/components/parameters/CSRF" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DraftSalesRequest" } } } }, "responses": { "200": { "description": "Draft revision" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/api/v1/drafts/losses": {
      "post": { "parameters": [{ "$ref": "#/components/parameters/CSRF" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DraftLossRequest" } } } }, "responses": { "200": { "description": "Draft revision" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/api/v1/drafts/evidence": {
      "post": { "parameters": [{ "$ref": "#/components/parameters/CSRF" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DraftEvidenceRequest" } } } }, "responses": { "200": { "description": "Draft revision" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/api/v1/submissions": {
      "post": { "parameters": [{ "$ref": "#/components/parameters/CSRF" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmitRequest" } } } }, "responses": { "200": { "description": "Report submission" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/api/v1/shifts/{id}": {
      "get": { "parameters": [{ "$ref": "#/components/parameters/ResourceID" }], "responses": { "200": { "description": "Shift detail" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/api/v1/report/{id}": {
      "get": { "parameters": [{ "$ref": "#/components/parameters/ResourceID" }], "responses": { "200": { "description": "Report view" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/api/v1/reports/{id}": {
      "get": { "parameters": [{ "$ref": "#/components/parameters/ResourceID" }, { "$ref": "#/components/parameters/StationID" }], "responses": { "200": { "description": "Typed report view", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReportView" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "$ref": "#/components/responses/NotFound" } } }
    },
    "/api/v1/reports/{id}/acknowledgement": {
      "post": { "parameters": [{ "$ref": "#/components/parameters/ResourceID" }, { "$ref": "#/components/parameters/CSRF" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AcknowledgeRequest" } } } }, "responses": { "200": { "description": "Acknowledgement" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/api/v1/amendments": {
      "post": { "parameters": [{ "$ref": "#/components/parameters/CSRF" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AmendmentRequest" } } } }, "responses": { "200": { "description": "Amendment request" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/api/v1/amendments/{id}/approve": {
      "post": { "parameters": [{ "$ref": "#/components/parameters/ResourceID" }, { "$ref": "#/components/parameters/CSRF" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AmendmentApprovalRequest" } } } }, "responses": { "200": { "description": "Applied amendment" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/api/v1/amendments/{id}/reject": {
      "post": { "parameters": [{ "$ref": "#/components/parameters/ResourceID" }, { "$ref": "#/components/parameters/CSRF" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AmendmentRejectionRequest" } } } }, "responses": { "204": { "description": "Amendment rejected" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/api/v1/policies/revisions": {
      "post": { "parameters": [{ "$ref": "#/components/parameters/CSRF" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PolicyRevisionRequest" } } } }, "responses": { "200": { "description": "Policy revision" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/ValidationError" } } }
    },
    "/api/v1/report/{id}/printout": {
      "get": { "parameters": [{ "$ref": "#/components/parameters/ResourceID" }], "responses": { "200": { "description": "Report printout" }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/api/v1/audit/export": {
      "get": { "responses": { "200": { "description": "Audit CSV export", "content": { "text/csv": {} } }, "401": { "$ref": "#/components/responses/Unauthorized" } } }
    },
    "/api/v1/audit/verify": {
      "get": { "responses": { "200": { "description": "Audit verification" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    }
  },
  "components": {
    "parameters": {
      "ResourceID": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "StationID": { "name": "station_id", "in": "query", "required": false, "schema": { "type": "string", "format": "uuid" } }
      ,"CSRF": { "name": "X-Requested-With", "in": "header", "required": true, "schema": { "type": "string" } }
      ,"IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1 } }
    },
    "schemas": {
      "LoginRequest": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password" } }, "additionalProperties": false },
      "OpenShiftRequest": { "type": "object", "required": ["station_id", "opened_at", "backfilled"], "properties": { "station_id": { "type": "string", "format": "uuid" }, "opened_at": { "type": "string", "format": "date-time" }, "backfilled": { "type": "boolean" }, "original_event_date": { "type": "string", "format": "date" }, "shift_ke": { "type": "integer", "minimum": 1 }, "backfill_approver": { "type": "string", "format": "uuid" }, "backfill_reason": { "type": "string" } }, "additionalProperties": false },
      "ClaimDraftRequest": { "type": "object", "required": ["station_id", "shift_id", "draft_id"], "properties": { "station_id": { "type": "string", "format": "uuid" }, "shift_id": { "type": "string", "format": "uuid" }, "draft_id": { "type": "string", "format": "uuid" } }, "additionalProperties": false },
      "DraftLeaseRequest": { "type": "object", "required": ["station_id", "draft_id", "claim_token"], "properties": { "station_id": { "type": "string", "format": "uuid" }, "draft_id": { "type": "string", "format": "uuid" }, "claim_token": { "type": "string", "format": "uuid" } }, "additionalProperties": false },
      "DraftReadingRequest": { "type": "object", "required": ["station_id", "draft_id", "claim_token", "revision", "nozzle_id", "meter_start", "meter_end"], "properties": { "station_id": { "type": "string", "format": "uuid" }, "draft_id": { "type": "string", "format": "uuid" }, "claim_token": { "type": "string", "format": "uuid" }, "revision": { "type": "integer", "minimum": 1 }, "nozzle_id": { "type": "string", "format": "uuid" }, "meter_start": { "$ref": "#/components/schemas/DecimalString" }, "meter_end": { "$ref": "#/components/schemas/DecimalString" } }, "additionalProperties": false },
      "DraftSalesRequest": { "type": "object", "required": ["station_id", "draft_id", "claim_token", "revision", "dispenser_id", "cash_amount", "cashless_amount"], "properties": { "station_id": { "type": "string", "format": "uuid" }, "draft_id": { "type": "string", "format": "uuid" }, "claim_token": { "type": "string", "format": "uuid" }, "revision": { "type": "integer", "minimum": 1 }, "dispenser_id": { "type": "string", "format": "uuid" }, "cash_amount": { "$ref": "#/components/schemas/DecimalString" }, "cashless_amount": { "$ref": "#/components/schemas/DecimalString" } }, "additionalProperties": false },
      "DraftLossRequest": { "type": "object", "required": ["station_id", "draft_id", "claim_token", "revision", "loss_id", "direction", "reason_code", "liters"], "properties": { "station_id": { "type": "string", "format": "uuid" }, "draft_id": { "type": "string", "format": "uuid" }, "claim_token": { "type": "string", "format": "uuid" }, "revision": { "type": "integer", "minimum": 1 }, "loss_id": { "type": "string", "format": "uuid" }, "direction": { "type": "string", "enum": ["loss", "gain"] }, "reason_code": { "type": "string" }, "liters": { "$ref": "#/components/schemas/DecimalString" }, "cash_amount": { "$ref": "#/components/schemas/DecimalString" }, "note": { "type": "string" } }, "additionalProperties": false },
      "DraftEvidenceRequest": { "type": "object", "required": ["station_id", "draft_id", "claim_token", "revision", "loss_row_id", "evidence_type", "object_key", "content_hash", "size_bytes", "mime"], "properties": { "station_id": { "type": "string", "format": "uuid" }, "draft_id": { "type": "string", "format": "uuid" }, "claim_token": { "type": "string", "format": "uuid" }, "revision": { "type": "integer", "minimum": 1 }, "loss_row_id": { "type": "string", "format": "uuid" }, "evidence_type": { "type": "string" }, "object_key": { "type": "string" }, "content_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }, "size_bytes": { "type": "integer", "minimum": 1 }, "mime": { "type": "string" } }, "additionalProperties": false },
      "SubmitRequest": { "type": "object", "required": ["station_id", "shift_id", "draft_id", "claim_token", "revision", "payload"], "properties": { "station_id": { "type": "string", "format": "uuid" }, "shift_id": { "type": "string", "format": "uuid" }, "draft_id": { "type": "string", "format": "uuid" }, "claim_token": { "type": "string", "format": "uuid" }, "revision": { "type": "integer", "minimum": 1 }, "payload": { "type": "object", "additionalProperties": false } }, "additionalProperties": false },
      "AcknowledgeRequest": { "type": "object", "required": ["station_id", "shift_id", "version_no", "decision"], "properties": { "station_id": { "type": "string", "format": "uuid" }, "shift_id": { "type": "string", "format": "uuid" }, "version_no": { "type": "integer", "minimum": 1 }, "decision": { "type": "string", "enum": ["acked", "rejected"] }, "rejection_reason": { "type": "string" }, "is_break_glass": { "type": "boolean" }, "break_glass_reason": { "type": "string" } }, "additionalProperties": false },
      "AmendmentItem": { "type": "object", "required": ["target_kind", "target_logical_id", "field", "old_value", "new_value"], "properties": { "target_kind": { "type": "string" }, "target_logical_id": { "type": "string", "format": "uuid" }, "field": { "type": "string" }, "old_value": { "type": "string" }, "new_value": { "type": "string" } }, "additionalProperties": false },
      "AmendmentRequest": { "type": "object", "required": ["station_id", "shift_id", "base_report_id", "reason", "stale_check_hash", "items"], "properties": { "station_id": { "type": "string", "format": "uuid" }, "shift_id": { "type": "string", "format": "uuid" }, "base_report_id": { "type": "string", "format": "uuid" }, "reason": { "type": "string" }, "stale_check_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }, "is_break_glass": { "type": "boolean" }, "break_glass_reason": { "type": "string" }, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/AmendmentItem" } } }, "additionalProperties": false },
      "AmendmentApprovalRequest": { "type": "object", "required": ["station_id", "stale_check_hash"], "properties": { "station_id": { "type": "string", "format": "uuid" }, "stale_check_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } }, "additionalProperties": false },
      "AmendmentRejectionRequest": { "type": "object", "required": ["station_id", "rejection_reason"], "properties": { "station_id": { "type": "string", "format": "uuid" }, "rejection_reason": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
      "PolicyRevisionRequest": { "type": "object", "required": ["policy_kind", "policy_id", "valid_from"], "properties": { "policy_kind": { "type": "string", "enum": ["threshold", "evidence"] }, "policy_id": { "type": "string", "format": "uuid" }, "station_id": { "type": "string", "format": "uuid" }, "valid_from": { "type": "string", "format": "date-time" }, "supersedes_revision_id": { "type": "string", "format": "uuid" }, "disabled": { "type": "boolean" }, "tombstone_reason": { "type": "string" }, "loss_liter_threshold": { "$ref": "#/components/schemas/DecimalString" }, "gain_liter_threshold": { "$ref": "#/components/schemas/DecimalString" }, "loss_rupiah_threshold": { "$ref": "#/components/schemas/DecimalString" }, "gain_rupiah_threshold": { "$ref": "#/components/schemas/DecimalString" }, "variance_rupiah_threshold": { "$ref": "#/components/schemas/DecimalString" }, "rollover_threshold": { "$ref": "#/components/schemas/DecimalString" }, "evidence_mode": { "type": "string", "enum": ["wajib", "opsional"] } }, "additionalProperties": false },
      "Error": { "type": "object", "required": ["code", "message", "request_id"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "request_id": { "type": "string" }, "field_errors": { "type": "object", "additionalProperties": { "type": "string" } } } },
      "DecimalString": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
      "ReportView": {
        "type": "object",
        "additionalProperties": false,
        "required": ["report_id", "station_id", "shift_id", "version_no", "status", "submitted_at", "readings", "sales", "losses"],
        "properties": {
          "report_id": { "type": "string", "format": "uuid" },
          "station_id": { "type": "string", "format": "uuid" },
          "shift_id": { "type": "string", "format": "uuid" },
          "version_no": { "type": "integer", "minimum": 1 },
          "status": { "type": "string" },
          "submitted_at": { "type": "string", "format": "date-time" },
          "readings": { "type": "array", "items": { "$ref": "#/components/schemas/ReportReading" } },
          "sales": { "type": "array", "items": { "$ref": "#/components/schemas/ReportSale" } },
          "losses": { "type": "array", "items": { "$ref": "#/components/schemas/ReportLoss" } }
        }
      },
      "ReportReading": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nozzle_id", "meter_start", "meter_end", "expected_sale"],
        "properties": {
          "nozzle_id": { "type": "string", "format": "uuid" },
          "meter_start": { "$ref": "#/components/schemas/DecimalString" },
          "meter_end": { "$ref": "#/components/schemas/DecimalString" },
          "expected_sale": { "$ref": "#/components/schemas/DecimalString" }
        }
      },
      "ReportSale": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dispenser_id", "cash_amount", "cashless_amount"],
        "properties": {
          "dispenser_id": { "type": "string", "format": "uuid" },
          "cash_amount": { "$ref": "#/components/schemas/DecimalString" },
          "cashless_amount": { "$ref": "#/components/schemas/DecimalString" }
        }
      },
      "ReportLoss": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row_id", "loss_id", "direction", "liters"],
        "properties": {
          "row_id": { "type": "string", "format": "uuid" },
          "loss_id": { "type": "string", "format": "uuid" },
          "direction": { "type": "string" },
          "liters": { "$ref": "#/components/schemas/DecimalString" },
          "cash_amount": { "$ref": "#/components/schemas/DecimalString" },
          "note": { "type": "string" }
        }
      }
    },
    "responses": {
      "ValidationError": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Request forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Resource not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "State conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ServiceUnavailable": { "description": "Service unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
